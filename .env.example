# Local SQLite for the MVP - swap for Postgres later without changing app code
DATABASE_URL="file:./dev.db"

# Signs session cookies. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-random-value"

# Only needed once an agent calls out to a real LLM instead of the mock rules engine
# ANTHROPIC_API_KEY=

# Google Calendar sync (Orbit Pulse). Without these, the "Connect Google
# Calendar" button in Settings shows a "not set up yet" message instead of
# crashing — the rest of the app works fine without it.
#
# One-time setup in Google Cloud Console (https://console.cloud.google.com):
#   1. Create a project (or use an existing one).
#   2. APIs & Services > Library > enable "Google Calendar API".
#   3. APIs & Services > OAuth consent screen > User Type "External" >
#      fill in the required fields > under "Test users" add your own
#      Google account's email (required while the app is unverified).
#   4. APIs & Services > Credentials > Create Credentials > OAuth client ID >
#      Application type "Web application".
#      Authorized redirect URI: http://localhost:3000/api/calendar/google/callback
#   5. Copy the generated Client ID and Client Secret below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:3000/api/calendar/google/callback"

# Web Push notifications — fully self-contained, no third-party account
# needed. Generate your own pair with:
#   npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Same value as VAPID_PUBLIC_KEY — exposed to the browser to subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

// The Customer Life Graph — the single shared data model all three
// agents (Pulse, Yield, Shield) read from and write to.
//
// Backend/agents track owns this file. If you change a model here,
// ping the frontend track before merging — it changes the API shape.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  themeMode     String         @default("dark") // "dark" | "light"
  accentColor   String         @default("red") // one of ACCENT_PRESETS in src/lib/theme.ts
  accounts      Account[]
  calendarEvents CalendarEvent[]
  subscriptions Subscription[]
  agentActions  AgentAction[]
  guardrails    GuardrailSettings?
  calendarConnection CalendarConnection?
  pushSubscriptions PushSubscription[]
  tripLearning  TripLearning?
  createdAt     DateTime       @default(now())
}

// A browser's Web Push subscription (see src/lib/push.ts). A user can have
// more than one — one per browser/device they've enabled notifications on.
model PushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// A simple running average of actual-vs-predicted trip spend, updated by
// the post-trip summary in src/lib/agents/pulse.ts — this is what lets
// future pre-trip briefings suggest a learned amount instead of a flat
// default.
model TripLearning {
  id                       String   @id @default(cuid())
  user                     User     @relation(fields: [userId], references: [id])
  userId                   String   @unique
  avgActualVsPredictedRatio Float   @default(1)
  tripCount                Int      @default(0)
  updatedAt                DateTime @updatedAt
}

// A linked external calendar account (see src/lib/googleCalendar.ts). One
// row per user — connecting a new account replaces the old one.
model CalendarConnection {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id])
  userId       String    @unique
  provider     String    @default("google")
  email        String? // the connected account's email, for display only
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
}

// The thresholds each agent must stay within — set by the user on the
// Guardrails screen. One row per user, created with defaults on first read.
model GuardrailSettings {
  id                 String   @id @default(cuid())
  user               User     @relation(fields: [userId], references: [id])
  userId             String   @unique
  minBalance         Float    @default(1500) // Yield: never recommend transferring below this
  monthlyAllocation  Float    @default(3000) // Shield: budget the monthly subscription spend is compared against
  riskComfort        String   @default("Conservative") // "Conservative" | "Moderate" | "Aggressive"
  connectCalendar    Boolean  @default(true) // Pulse: whether calendar-based trip detection runs at all
  detectLifeEvents   Boolean  @default(true)
  preTripDays        Int      @default(7) // Pulse: only surface the pre-trip briefing inside this window
  flagAfterDays      Int      @default(30) // Shield: flag a subscription once unused this many days
  autoTripMode       Boolean  @default(true) // Shield: auto-activate Trip Mode when Pulse detects travel
  allowNegotiation   Boolean  @default(true) // Shield: offer "negotiate" as an option on flagged subscriptions
  updatedAt          DateTime @updatedAt
}

model Account {
  id           String        @id @default(cuid())
  user         User          @relation(fields: [userId], references: [id])
  userId       String
  name         String // e.g. "DBS Multiplier"
  type         String // "savings" | "current" | "fixed_deposit"
  balance      Float
  interestRate Float // annual %, e.g. 0.05 for idle savings
  currency     String        @default("SGD")
  transactions Transaction[]
}

model Transaction {
  id        String   @id @default(cuid())
  account   Account  @relation(fields: [accountId], references: [id])
  accountId String
  merchant  String
  amount    Float
  category  String // "subscription" | "travel" | "general" ...
  occurredAt DateTime
}

model CalendarEvent {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     String // "Flight to Seoul"
  location  String?
  startsAt  DateTime
  endsAt    DateTime
  // Orbit Pulse reads this to infer life events (trips, moves, etc.)
  inferredEventType String? // "trip" | "relocation" | "unknown"
  source     String   @default("manual") // "manual" | "google"
  externalId String? // the source calendar's event id, for de-duping on re-sync

  @@unique([userId, externalId])
}

model Subscription {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  merchant      String // "Disney+"
  monthlyAmount Float
  lastUsedAt    DateTime?
  usageScore    Float    @default(1) // 0 = never used, 1 = used constantly
  status        String   @default("active") // "active" | "flagged" | "cancelled"
}

// Every autonomous suggestion or action any agent takes, for the
// MAS-compliant audit trail. Nothing executes without a matching row here.
//
// id is a deterministic string minted by the agent rule functions (e.g.
// "pulse_evt_korea"), not an auto-generated cuid — this lets syncAgentActions
// upsert on every request instead of creating duplicate rows.
model AgentAction {
  id          String   @id
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  agent       String // "pulse" | "yield" | "shield"
  actionType  String // "recommendation" | "autonomous_action"
  description String
  reasoning   String? // plain-English "why" — the guardrail/threshold that triggered it
  amount      Float? // the SGD figure this action is about, if any (structured, not parsed from description)
  requiresApproval Boolean @default(true)
  status      String   @default("pending") // "pending" | "approved" | "dismissed"
  approvedAt  DateTime?
  notifiedAt  DateTime? // set once a push notification has been sent for this action
  createdAt   DateTime @default(now())
}
